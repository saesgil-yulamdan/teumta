PORT=3000
DATABASE_URL="mysql://teumta:change_me@localhost:3306/teumta"

# 관리자 인증 비밀번호 (관리자 웹 로그인 + /api/admin/* 보호).
# 미설정 시 모든 관리자 API가 거부된다(fail closed). 배포 환경에도 반드시 설정.
ADMIN_PASSWORD=

# 브라우저에서 API를 호출할 허용 Origin(쉼표 구분). 모바일 native 요청에는 Origin이 없다.
# 관리자 웹은 폐기 상태라 기본은 비움. 다시 사용할 때만 관리자 웹 Origin을 추가한다.
CORS_ALLOWED_ORIGINS=

# 앱에서 사용하지 않는 레거시 Trip/TripEvent API. 기본 false 유지 권장.
ENABLE_LEGACY_TRIP_API=false

# 외부 API 인증키 (실제 키는 .env 에만 작성, Git 커밋 금지)
# TOUR_API_KEY / PREDICTION_API_KEY 는 공공데이터포털 Encoding/Decoding 키 모두 허용
# (코드에서 정규화 후 정확히 한 번만 인코딩하므로 이중 인코딩 걱정 없음).
# 두 API가 같은 활용신청 키를 쓰더라도 변수는 각각 설정한다.
TOUR_API_KEY=
CONGESTION_API_KEY=
TMAP_API_KEY=
PREDICTION_API_KEY=

# 외부 API base URL
# TourAPI: 국문 관광정보 서비스(KorService2, 매뉴얼 v4.4)
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
# 집중률 예측: 관광지 집중률 방문자 추이 예측(TatsCnctrRateService, 오퍼레이션 tatsCnctrRatedList)
# - 향후 30일의 "날짜별" 집중률 예측(일 1회 갱신). 실시간 혼잡도·시간대별 예측이 아님.
PREDICTION_API_BASE_URL=https://apis.data.go.kr/B551011/TatsCnctrRateService
# SK 지오비전 퍼즐 실시간 장소 혼잡도(CONGESTION_API_KEY = TMAP과 같은 SK appKey)
CONGESTION_API_BASE_URL=https://apis.openapi.sk.com/puzzle
TMAP_API_BASE_URL=https://apis.openapi.sk.com

# 외부 API 공통 요청 timeout (ms)
EXTERNAL_API_TIMEOUT_MS=5000

# 집중률 예측 일일 자동 적재 대상("areaCd:signguCd" 쉼표 구분). 비우면 비활성.
# 예: 서울 종로구 = 11:11110
PREDICTION_INGEST_TARGETS=
# 일일 적재 실행 시각(KST, 0~23)
PREDICTION_INGEST_HOUR_KST=5

# 수동 적재 명령어(키/DB 설정 후):
#   npm run ingest:tour -- <mapX(경도)> <mapY(위도)> [radius(m, 1~20000)]
#   npm run ingest:prediction -- --areaCd=11 --signguCd=11110 [--name=경복궁]
