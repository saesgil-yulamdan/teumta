PORT=3000
NODE_ENV=development

# 브라우저 허용 Origin(쉼표 구분). native 앱 요청에는 Origin이 없습니다.
CORS_ALLOWED_ORIGINS=

# 외부 API 인증키. 실제 값은 .env에만 작성하고 커밋하지 않습니다.
TOUR_API_KEY=
CONGESTION_API_KEY=
TMAP_API_KEY=
PREDICTION_API_KEY=

TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
PREDICTION_API_BASE_URL=https://apis.data.go.kr/B551011/TatsCnctrRateService
CONGESTION_API_BASE_URL=https://apis.openapi.sk.com/puzzle
TMAP_API_BASE_URL=https://apis.openapi.sk.com

# 외부 API 한 번의 공통 timeout(ms). 모바일 코스 요청 timeout(30초)과 별개입니다.
EXTERNAL_API_TIMEOUT_MS=5000

# 아래 변수는 현재 공개 서버 기동/API에는 사용하지 않습니다.
# 보존된 Prisma 적재 스크립트·과거 코드를 별도로 실행할 때만 설정합니다.
DATABASE_URL=
ADMIN_PASSWORD=
ENABLE_LEGACY_TRIP_API=false
PREDICTION_INGEST_TARGETS=
PREDICTION_INGEST_HOUR_KST=5
