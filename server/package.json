{
  "name": "teumta-server",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "dev": "tsx watch src/server.ts",
    "ingest:prediction": "tsx scripts/ingest-prediction.ts",
    "ingest:tour": "tsx scripts/ingest-tour.ts",
    "measure:congestion": "tsx scripts/measure-featured-congestion.ts",
    "smoke:live": "node scripts/smoke-live.mjs",
    "postinstall": "if [ -f prisma/schema.prisma ]; then prisma generate; fi",
    "start": "node dist/server.js",
    "start:deploy": "prisma migrate deploy && node dist/server.js",
    "test": "vitest",
    "test:run": "vitest run"
  },
